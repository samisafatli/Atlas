generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id           String        @id @default(cuid())
  name         String
  type         String
  currency     String        @default("BRL")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name, type])
}

model Category {
  id           String         @id @default(cuid())
  name         String
  type         String
  transactions Transaction[]
  rules        CategoryRule[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([name, type])
}

model CategoryRule {
  id         String   @id @default(cuid())
  contains   String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([contains, categoryId])
  @@index([enabled])
}

model AssetAccount {
  id          String               @id @default(cuid())
  name        String
  institution String
  type        String
  currency    String               @default("BRL")
  snapshots   AssetSnapshotValue[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([name, institution])
}

model AssetSnapshot {
  id           String               @id @default(cuid())
  snapshotDate DateTime             @unique
  totalCents   BigInt
  values       AssetSnapshotValue[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([snapshotDate])
}

model AssetSnapshotValue {
  snapshotId  String
  accountId   String
  amountCents BigInt
  snapshot    AssetSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  account     AssetAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([snapshotId, accountId])
  @@index([accountId])
}

model Transaction {
  id          String    @id @default(cuid())
  description String
  amountCents BigInt
  type        String
  occurredAt  DateTime
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importId    String?
  importedIn  Import?   @relation(fields: [importId], references: [id], onDelete: SetNull)
  fingerprint String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([occurredAt])
  @@index([accountId])
  @@index([categoryId])
  @@index([importId])
}

model Import {
  id               String        @id @default(cuid())
  filename         String
  importedAt       DateTime      @default(now())
  transactionCount Int
  transactions     Transaction[]
}
